{"schema_version":2,"diagram_type":"workflow","meta":{"title":"作业与补丁任务执行链路","locale":"zh-CN","quality_profile":"showcase","views":[{"id":"submit","label":"提交与排队","focus":["operator","job-api","job-record","celery"],"note":"用户提交脚本、文件分发或 Playbook，Server 先创建执行记录并投递异步任务。"},{"id":"execute","label":"Agent 执行","focus":["celery","nats","executor","target"],"note":"Celery Worker 通过 NATS 调度 nats-executor 或 ansible-executor。"},{"id":"callback","label":"回调与展示","focus":["executor","callback","job-record","web-result"],"note":"执行结果和流式日志回到 Server，再由 Web 展示终态。"}],"viewBox":[1470,900]},"lanes":[{"id":"operator","label":"用户与控制台"},{"id":"control","label":"Django Server"},{"id":"runtime","label":"异步调度与执行"}],"phases":[{"id":"accept","label":"接收任务","fromCol":0,"toCol":1},{"id":"run","label":"执行与观测","fromCol":2,"toCol":4,"variant":"emphasis"},{"id":"finish","label":"终态与补偿","fromCol":5,"toCol":5,"variant":"dashed"}],"mainPath":["operator","job-api","job-record","celery","nats","executor","target","callback","web-result"],"nodes":[{"id":"operator","lane":"operator","col":0,"type":"external","label":"用户"},{"id":"job-api","lane":"control","col":1,"width":130,"type":"backend","label":"Job / Patch API"},{"id":"job-record","lane":"control","col":2,"type":"database","label":"执行记录"},{"id":"celery","lane":"runtime","col":2,"width":150,"type":"messagebus","label":"Celery Worker + Beat"},{"id":"nats","lane":"runtime","col":3,"width":150,"type":"messagebus","label":"NATS RPC / JetStream"},{"id":"executor","lane":"runtime","col":4,"type":"backend","label":"Executor Agent"},{"id":"target","lane":"runtime","col":5,"type":"external","label":"目标主机"},{"id":"callback","lane":"control","col":5,"type":"backend","label":"回调处理"},{"id":"web-result","lane":"operator","col":5,"type":"frontend","label":"执行结果页"}],"edges":[{"from":"operator","to":"job-api","label":"提交任务","role":"main","variant":"emphasis"},{"from":"job-api","to":"job-record","label":"创建执行记录","role":"main"},{"from":"job-record","to":"celery","label":"投